            "params": [
              {
                "name": "cpeNameId",
                "value": "",
                "type": "query",
                "description": "Specific CPE record UUID."
              },
              {
                "name": "cpeMatchString",
                "value": "",
                "type": "query"
              },
              {
                "name": "keywordSearch",
                "value": "",
                "type": "query"
              },
              {
                "name": "keywordExactMatch",
                "value": "",
                "type": "query"
              },
              {
                "name": "lastModStartDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "lastModEndDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "matchCriteriaId",
                "value": "",
                "type": "query"
              },
              {
                "name": "resultsPerPage",
                "value": "",
                "type": "query",
                "description": "Maximum results per page (default and max 10000)."
              },
              {
                "name": "startIndex",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve Common Platform Enumeration records with optional filters by CPE Name ID, match string, keyword, modification date range, and match criteria identifier."
